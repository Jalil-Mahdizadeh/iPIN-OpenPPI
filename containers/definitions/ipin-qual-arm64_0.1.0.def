Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.08-py3

%labels
    org.opencontainers.image.title "iPIN-OpenPPI Arrhenius qualification"
    org.opencontainers.image.version "0.1.0"
    org.opencontainers.image.created "2026-08-03"
    org.opencontainers.image.source "https://catalog.ngc.nvidia.com/orgs/nvidia/containers/pytorch"
    ipin.blueprint.version "3.0"
    ipin.architecture "aarch64"
    ipin.purpose "single-GH200 deterministic PyTorch and checkpoint qualification"

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONHASHSEED=0
    export TOKENIZERS_PARALLELISM=false
    export CUBLAS_WORKSPACE_CONFIG=:4096:8

%test
    python -c "import platform, torch; assert platform.machine() == 'aarch64'; print(platform.machine(), torch.__version__)"

%runscript
    exec python "$@"

